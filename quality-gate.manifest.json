{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "Fraud-CRI",
      "component": "ipv-cri-fraud-front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/checks.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/checks.yml",
          "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run lint']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "regression"
              ]
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/checks.yml",
          "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run test and write coverage']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/checks.yml",
          "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run CloudFormation tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "accessibility"
            },
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/checks.yml",
          "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run browser tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/checks.yml",
          "path": "$.jobs.run-premerge-checks.steps[?@.name=='Sonar scan']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/codeql.yml",
          "path": "$.jobs.analyze"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/i18n.yml",
          "path": "$.jobs.check-i18n"
        }
      ]
    }
  ]
}
